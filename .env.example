# ==============================================================================
# IncidentFlow Environment Configuration Template (.env.example)
# ==============================================================================

# Application General
APP_NAME=IncidentFlow
DEBUG=false
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kolkata

# Database (PostgreSQL)
# Local Docker / Render URL
DATABASE_URL=postgresql+asyncpg://incidentflow:incidentflow_dev@localhost:5432/incidentflow

# Redis (Cache / Celery Queue)
REDIS_URL=redis://localhost:6379/0

# Authentication / Security
# Generate a strong key with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# CORS Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000","https://app.yourdomain.com"]

# Frontend Public API URL (for frontend deployment)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ServiceNow Integration
# When true, IncidentFlow simulates all ServiceNow API events without contacting ServiceNow
SERVICENOW_MOCK=true
SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=incidentflow_integration
SERVICENOW_PASSWORD=secure_servicenow_password
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# Assignment Engine Settings
AUTO_ASSIGNMENT_ENABLED=true
# Options: ROUND_ROBIN | LEAST_WORKLOAD | SKILL_BASED | SKILL_PLUS_WORKLOAD
ASSIGNMENT_STRATEGY=SKILL_PLUS_WORKLOAD
DRY_RUN_MODE=false
SHADOW_MODE=false

# Notification Service (Email Delivery)
# Options: MOCK (safe development mode, no outbound emails) | SMTP (live delivery)
EMAIL_PROVIDER=MOCK
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@incidentflow.dev
SMTP_TLS=true
