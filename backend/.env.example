EMAIL_PROVIDER=MOCK
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=IncidentFlow
LIVE_PILOT_ENABLED=False
LIVE_PILOT_ASSIGNMENT_GROUP="Analytics – MDM L3"
LIVE_PILOT_MAX_ACTIVE_ASSIGNMENTS=5
LIVE_PILOT_ALLOWED_EMPLOYEES='["ravi@incidentflow.dev","kiran@incidentflow.dev"]'
LIVE_PILOT_REQUIRE_ELIGIBILITY=True
LIVE_PILOT_REQUIRE_SERVICE_NOW_SYNC=True
